{
  "name": "loom",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:fast": "tsc --build",
    "dev": "turbo dev",
    "test": "turbo test",
    "bench": "turbo bench",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --build",
    "clean": "turbo clean",
    "fitness": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "present": "npx @marp-team/marp-cli@latest -s docs/presentation/",
    "link:global": "cd tools/cli && npm link && cd ../compiler && npm link && cd ../create-loom-app && npm link",
    "unlink:global": "npm rm --global @loom/cli @loom/compiler @loom/create-loom-app",
    "test:src": "LOOM_TEST_SRC=1 turbo test",
    "test:perf": "LOOM_TEST_PERF=1 turbo test --force"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.4",
  "license": "Apache-2.0"
}
