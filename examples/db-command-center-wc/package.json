{
  "name": "@loom/db-command-center-wc",
  "version": "0.0.1",
  "description": "Agentic Database Command Center rendered with vanilla Web Components — no React, no Angular. Same Loom agentic backend, a Custom-Elements BYOR/BYOC render layer.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/a2a": "workspace:*",
    "@loom/a2ui": "workspace:*",
    "@loom/agent": "workspace:*",
    "@loom/blueprint-runtime": "workspace:*",
    "@loom/capability": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/intent": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/planner": "workspace:*",
    "@loom/projection-runtime": "workspace:*",
    "@loom/registry": "workspace:*",
    "@loom/sdk": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
