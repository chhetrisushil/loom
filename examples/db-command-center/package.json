{
  "name": "@loom/db-command-center",
  "version": "0.0.1",
  "description": "Agentic Database Command Center — intent-driven, human-in-the-loop, multi-agent (A2A) reference app for the Loom framework. Demonstrates BYOR + BYOC + render-side fiber.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/a2a": "workspace:*",
    "@loom/a2ui": "workspace:*",
    "@loom/agent": "workspace:*",
    "@loom/blueprint-runtime": "workspace:*",
    "@loom/capability": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/intent": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/planner": "workspace:*",
    "@loom/projection-runtime": "workspace:*",
    "@loom/registry": "workspace:*",
    "@loom/renderer-react": "workspace:*",
    "@loom/sdk": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loom/compiler": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
