{
  "name": "@loom/db-observability",
  "version": "0.0.1",
  "description": "A dynamic database-observability dashboard: a user's natural-language question is analysed by an agent, categorised into a topic + a WHAT (the direct answer) and WHY (the supporting explanation), and a Loom blueprint UI is GENERATED DYNAMICALLY from an available widget catalogue bound to live telemetry projections. Renders headlessly via renderer-terminal AND as a React dashboard (Recharts) via renderer-react \u2014 the same blueprint, two surfaces.",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/blueprint-runtime": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/orchestration": "workspace:*",
    "@loom/plugin-content": "workspace:*",
    "@loom/plugin-mcp": "workspace:*",
    "@loom/plugin-renderer-react": "workspace:*",
    "@loom/plugin-renderer-terminal": "workspace:*",
    "@loom/plugin-sandbox": "workspace:*",
    "@loom/projection-runtime": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
