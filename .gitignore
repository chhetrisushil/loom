node_modules/
dist/
.turbo/
coverage/
*.db
*.db-journal
*.db-wal
*.db-shm
.DS_Store
*.local
.env
tsconfig.tsbuildinfo
**/*.js.map
**/*.d.ts.map

# Generated docs (rebuild with scripts/build-architecture-pdf.sh)
docs/pdf/*.pdf

# local model files for @loom/appgen-model (never commit — multi-GB)
.models/

# CLI test scratch (config fixtures + built-binary runs; removed by the tests themselves)
tools/cli/.tmp-*/

# scaffold template typecheck probe (removed by the test itself)
.tmp-template-types/

# `npm link` writes bin/ symlinks and a lib/ tree into the package it links. The symlinks
# point into the global prefix, so committing one gives everyone else a dangling link —
# which is exactly what happened once (79c8e35).
tools/*/bin/
tools/*/lib/

# loom evals scoreboard output (the committed baseline is evals/baseline/)
evals/out/
