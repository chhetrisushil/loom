{
  "name": "@loomwork/plugin-postgres",
  "version": "0.1.0",
  "description": "Postgres store adapters for Loom — network-backed EventStore, SnapshotStore, BranchRegistry, TimerStore, DurableStateStore, ReadModelStore and MemoryStore with cross-node live subscribe (LISTEN/NOTIFY). The horizontal-scale backend behind the same interfaces as the SQLite stores.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/core": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/memory": "workspace:^",
    "@loomwork/plugin-durable-state": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "pg": "^8.13.0",
    "@loomwork/plugin-kit": "workspace:^",
    "@loomwork/plugin-read-model": "workspace:^"
  },
  "devDependencies": {
    "@loomwork/replay-vm": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@loomwork/plugin-sqlite": "workspace:*",
    "@loomwork/conformance": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "plugins/postgres"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
