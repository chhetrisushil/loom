{
  "name": "@loom/plugin-postgres",
  "version": "0.0.1",
  "description": "Postgres store adapters for Loom — network-backed EventStore, SnapshotStore, and BranchRegistry with cross-node live subscribe (LISTEN/NOTIFY). The horizontal-scale backend behind the same interfaces as the SQLite stores.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/plugin-durable-state": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "pg": "^8.13.0",
    "@loom/plugin-kit": "workspace:*"
  },
  "devDependencies": {
    "@loom/replay-vm": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@loom/plugin-sqlite": "workspace:*"
  }
}
