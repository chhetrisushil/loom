{
  "name": "@loom/plugin-a2a",
  "version": "0.0.1",
  "description": "Agent-to-Agent (A2A) protocol client and server for Loom workflows",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cards": {
      "types": "./cards.d.ts",
      "require": "./dist/toAgentCard.js",
      "default": "./dist/toAgentCard.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loom/classify": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loom/event-runtime": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
