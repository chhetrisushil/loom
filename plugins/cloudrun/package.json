{
  "name": "@loomwork/plugin-cloudrun",
  "version": "0.1.2",
  "description": "Cloud Run platform adapter for Loom — CloudRunWorkerRuntime maps DispatchMetadata to a Cloud Run sizing config, resolves a service endpoint, and invokes the stateless worker. Cloud specifics stay behind the CloudRunPlatform SPI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/dispatcher": "workspace:^",
    "@loomwork/worker-runtime": "workspace:^",
    "@loomwork/plugin-worker-remote": "workspace:^"
  },
  "devDependencies": {
    "@loomwork/core": "workspace:*",
    "@loomwork/effect-runtime": "workspace:*",
    "@loomwork/event-runtime": "workspace:*",
    "@loomwork/snapshot-runtime": "workspace:*",
    "@loomwork/worker-runtime-local": "workspace:*",
    "@loomwork/plugin-worker-server": "workspace:*",
    "@loomwork/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8",
    "@loomwork/plugin-sqlite": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "plugins/cloudrun"
  },
  "files": [
    "dist",
    "src",
    "Dockerfile",
    "deploy.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
