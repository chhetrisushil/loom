{
  "name": "@loom/plugin-renderer-dom",
  "version": "0.0.1",
  "description": "Framework-free DOM renderer for Loom blueprints — a web surface without React or loom-ui",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/blueprint-runtime": "workspace:*",
    "@loom/projection-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/core": "workspace:*",
    "@loom/plugin-renderer-react": "workspace:*",
    "@loom/plugin-renderer-terminal": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
