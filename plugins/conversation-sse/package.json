{
  "name": "@loomwork/plugin-conversation-sse",
  "version": "0.1.2",
  "description": "Authenticated Server-Sent-Events gateway for @loomwork/conversation: streams a conversation's durable messages (resumable from Last-Event-ID) and live reply deltas to an end user, and carries the user's turns back in",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/classify": "workspace:^",
    "@loomwork/conversation": "workspace:^",
    "@loomwork/core": "workspace:^",
    "@loomwork/effect-runtime": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/llm": "workspace:^",
    "@loomwork/workflow-runtime": "workspace:^"
  },
  "devDependencies": {
    "@loomwork/agent": "workspace:*",
    "@loomwork/snapshot-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "plugins/conversation-sse"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
