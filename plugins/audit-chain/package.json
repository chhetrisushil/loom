{
  "name": "@loom/plugin-audit-chain",
  "version": "0.0.1",
  "description": "Tamper-evident hash-chained EventStore wrapper for Loom — each event carries H(prevHash ‖ canonical(event)) plus an optional HMAC signature, so the durable log is cryptographically verifiable. Fold-invisible: replay is byte-identical.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/event-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/conformance": "workspace:*",
    "@loom/dst": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/plugin-content": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
