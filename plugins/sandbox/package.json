{
  "name": "@loom/plugin-sandbox",
  "version": "0.0.1",
  "description": "Hardened QuickJS/WASM sandbox for LLM-authored reshaping code — content-addressed scripts, resource limits, no ambient I/O, shape-hash-validated output (ADR 0064)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "quickjs-emscripten": "^0.31.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loom/event-runtime": "workspace:*",
    "@loom/middleware": "workspace:*",
    "@loom/plugin-content": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
