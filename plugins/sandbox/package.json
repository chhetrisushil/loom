{
  "name": "@loomwork/plugin-sandbox",
  "version": "0.1.1",
  "description": "Hardened QuickJS/WASM sandbox for LLM-authored reshaping code — content-addressed scripts, resource limits, no ambient I/O, shape-hash-validated output (ADR 0064)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/core": "workspace:^",
    "@loomwork/effect-runtime": "workspace:^",
    "@loomwork/sandbox": "workspace:^",
    "quickjs-emscripten": "^0.31.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loomwork/conformance": "workspace:*",
    "@loomwork/event-runtime": "workspace:*",
    "@loomwork/middleware": "workspace:*",
    "@loomwork/plugin-content": "workspace:*",
    "@loomwork/snapshot-runtime": "workspace:*",
    "@loomwork/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "plugins/sandbox"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
