{
  "name": "@loomwork/plugin-mcp-app",
  "version": "0.1.2",
  "description": "MCP Apps (SEP-1865, `io.modelcontextprotocol/ui`) egress — projects a Loom agent surface onto the extension as ONE static, content-pinned surface-host template whose payload is the existing A2UI catalog model, plus an app-visibility surface cursor tool that closes the extension's missing server-push channel. Egress only: the host role (iframe, CSP, postMessage) is deliberately out of scope.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/agent-surface": "workspace:^",
    "@loomwork/classify": "workspace:^",
    "@loomwork/core": "workspace:^",
    "@loomwork/effect-runtime": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/plugin-a2ui": "workspace:^",
    "@loomwork/plugin-mcp": "workspace:^"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "plugins/mcp-app"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
