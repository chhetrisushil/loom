{
  "name": "@loom/plugin-mcp",
  "version": "0.0.1",
  "description": "MCP (Model Context Protocol) client for Loom workflows",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/classify": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loom/event-runtime": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/middleware": "workspace:*",
    "@loom/replay-vm": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
