{
  "name": "@loom/plugin-worker-server",
  "version": "0.0.1",
  "description": "Stateless Loom worker HTTP endpoint — POST /execute runs one ExecutionPackage on an injected WorkerRuntime and returns the ExecutionResult. The container entrypoint for remote/Cloud Run execution",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/dispatcher": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/worker-runtime-local": "workspace:*",
    "@loom/plugin-worker-remote": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8",
    "@loom/plugin-sqlite": "workspace:*"
  }
}
