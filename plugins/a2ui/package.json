{
  "name": "@loomwork/plugin-a2ui",
  "version": "0.1.2",
  "description": "A2UI adapter — projects Loom agent surfaces onto the Google A2UI (Agent-to-UI) wire protocol v1.0 (createSurface / updateDataModel / deleteSurface) so any A2UI-compliant client can render a Loom-driven UI. Egress + inbound actions + `callFunction` bidirectional RPC (client-invoked functions with a deterministic callId, reconciled with Loom's replay grain); continuous two-way binding sync remains out of scope.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/agent-surface": "workspace:^",
    "@loomwork/blueprint-runtime": "workspace:^",
    "@loomwork/classify": "workspace:^",
    "@loomwork/core": "workspace:^",
    "@loomwork/effect-runtime": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "plugins/a2ui"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
