{
  "name": "@loom/planner",
  "version": "0.0.1",
  "description": "Planner runtime for Loom \u2014 turns a goal into an ordered capability plan",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/agent": "workspace:*",
    "@loom/capability": "workspace:*",
    "@loom/classify": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/reasoning": "workspace:*",
    "@loom/scheduler": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loom/event-runtime": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
