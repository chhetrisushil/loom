{
  "name": "@loomwork/spec",
  "version": "0.1.1",
  "description": "The Loom kernel manifest — the single machine-readable source of truth aggregating every kernel/SPI version constant, the capability maturity registry, and a deployment compatibility validator. Read-only; imports the real exported constants so it can never drift.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/compiler": "workspace:^",
    "@loomwork/dispatcher": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/memory": "workspace:^",
    "@loomwork/plugin-content": "workspace:^",
    "@loomwork/replay-vm": "workspace:^",
    "@loomwork/sandbox": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "@loomwork/wire-abi": "workspace:^",
    "@loomwork/workflow-runtime": "workspace:^"
  },
  "devDependencies": {
    "@loomwork/blueprint-runtime": "workspace:*",
    "@loomwork/projection-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "packages/spec"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
