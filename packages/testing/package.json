{
  "name": "@loom/testing",
  "version": "0.0.1",
  "description": "Testing kit for Loom apps — spin up an in-memory app, wait on surfaces, capture golden logs, and record/replay LLM calls, all over defineConfig",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/app": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/projection-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/effect-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
