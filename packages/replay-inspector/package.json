{
  "name": "@loom/replay-inspector",
  "version": "0.0.1",
  "description": "Read-only replay inspector — reconstruct an execution's state at any point in its log, diff transitions, and read projection slices, under the version the execution is pinned to. A cache of the log, never an authority; no write path.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loom/classify": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/replay-vm": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/effect-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
