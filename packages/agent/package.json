{
  "name": "@loom/agent",
  "version": "0.1.0",
  "description": "ReAct-style agent loop for Loom workflows",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loom/classify": "workspace:^",
    "@loom/core": "workspace:^",
    "@loom/effect-runtime": "workspace:^",
    "@loom/llm": "workspace:^",
    "@loom/memory": "workspace:^",
    "@loom/reasoning": "workspace:^",
    "@loom/scheduler": "workspace:^",
    "@loom/workflow-runtime": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loom/capability": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/isolate": "workspace:*",
    "@loom/learning": "workspace:*",
    "@loom/middleware": "workspace:*",
    "@loom/orchestration": "workspace:*",
    "@loom/replay-vm": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/worker-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "packages/agent"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
