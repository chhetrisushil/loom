{
  "name": "@loomwork/workflow-runtime",
  "version": "0.1.0",
  "description": "Durable workflow execution runtime with suspend and resume",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./operator": {
      "types": "./operator.d.ts",
      "require": "./operator.js",
      "default": "./operator.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/classify": "workspace:^",
    "@loomwork/core": "workspace:^",
    "@loomwork/effect-runtime": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/replay-vm": "workspace:^",
    "@loomwork/scheduler": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@loomwork/compliance": "workspace:*",
    "@loomwork/conformance": "workspace:*",
    "@loomwork/middleware": "workspace:*",
    "@loomwork/plugin-content": "workspace:*",
    "@loomwork/plugin-crypto": "workspace:*",
    "@loomwork/plugin-postgres": "workspace:*",
    "@loomwork/plugin-sqlite": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "packages/workflow-runtime"
  },
  "files": [
    "dist",
    "src",
    "operator.d.ts",
    "operator.js",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
