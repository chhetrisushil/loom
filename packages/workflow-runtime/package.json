{
  "name": "@loom/workflow-runtime",
  "version": "0.0.1",
  "description": "Durable workflow execution runtime with suspend and resume",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./operator": {
      "types": "./operator.d.ts",
      "require": "./operator.js",
      "default": "./operator.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loom/classify": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/replay-vm": "workspace:*",
    "@loom/scheduler": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@loom/compliance": "workspace:*",
    "@loom/conformance": "workspace:*",
    "@loom/middleware": "workspace:*",
    "@loom/plugin-content": "workspace:*",
    "@loom/plugin-crypto": "workspace:*",
    "@loom/plugin-postgres": "workspace:*",
    "@loom/plugin-sqlite": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
