{
  "name": "@loom/cli",
  "version": "0.0.1",
  "description": "The loom CLI — project-local commands over the durable log: logs, debug (time-travel), eval",
  "bin": {
    "loom": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/eval": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/replay-vm": "workspace:*",
    "@loom/scaffold": "workspace:*"
  },
  "devDependencies": {
    "@loom/effect-runtime": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
