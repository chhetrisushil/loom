{
  "name": "@loom/scaffold",
  "version": "0.0.1",
  "description": "Shared code templates + registration codegen for Loom — used by create-loom-app (whole app) and `loom new`/`loom gen` (single files + generated registration)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
