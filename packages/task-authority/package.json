{
  "name": "@loomwork/task-authority",
  "version": "0.1.5",
  "description": "Task-scoped authority for Loom (ADR 0150): signed per-task grants, side-effect leases that pause on exhaustion, and child leases carved by reservation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "require": "./dist/conformance.js",
      "node": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/classify": "workspace:^",
    "@loomwork/effect-runtime": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loomwork/core": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/orchestration": "workspace:^",
    "@loomwork/replay-vm": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "@loomwork/workflow-runtime": "workspace:^",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "packages/task-authority"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@loomwork/core": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/orchestration": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "@loomwork/workflow-runtime": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@loomwork/core": {
      "optional": true
    },
    "@loomwork/event-runtime": {
      "optional": true
    },
    "@loomwork/orchestration": {
      "optional": true
    },
    "@loomwork/snapshot-runtime": {
      "optional": true
    },
    "@loomwork/workflow-runtime": {
      "optional": true
    }
  }
}
