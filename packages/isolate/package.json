{
  "name": "@loom/isolate",
  "version": "0.0.1",
  "description": "K7 data-plane isolation — run tool effects in a separate authority domain (child process with scrubbed env), with kernel-side egress brokering (allowlist + resolve-and-pin, EGRESS_DENIED) and per-tool credential injection",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/effect-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/middleware": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
