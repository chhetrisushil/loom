{
  "name": "@loomwork/sdk",
  "version": "0.1.1",
  "description": "Public re-export surface for the Loom framework",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "require": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "require": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "require": "./dist/sandbox.js",
      "default": "./dist/sandbox.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/agent": "workspace:^",
    "@loomwork/agent-surface": "workspace:^",
    "@loomwork/blueprint-runtime": "workspace:^",
    "@loomwork/capability": "workspace:^",
    "@loomwork/core": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/intent": "workspace:^",
    "@loomwork/knowledge": "workspace:^",
    "@loomwork/llm": "workspace:^",
    "@loomwork/memory": "workspace:^",
    "@loomwork/orchestration": "workspace:^",
    "@loomwork/planner": "workspace:^",
    "@loomwork/plugin-a2a": "workspace:^",
    "@loomwork/plugin-mcp": "workspace:^",
    "@loomwork/plugin-renderer-terminal": "workspace:^",
    "@loomwork/projection-runtime": "workspace:^",
    "@loomwork/reasoning": "workspace:^",
    "@loomwork/registry": "workspace:^",
    "@loomwork/sandbox": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "@loomwork/workflow-runtime": "workspace:^"
  },
  "peerDependencies": {
    "@loomwork/plugin-postgres": "workspace:^",
    "@loomwork/plugin-sandbox": "workspace:^",
    "@loomwork/plugin-sqlite": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@loomwork/plugin-postgres": {
      "optional": true
    },
    "@loomwork/plugin-sandbox": {
      "optional": true
    },
    "@loomwork/plugin-sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@loomwork/plugin-postgres": "workspace:*",
    "@loomwork/plugin-sandbox": "workspace:*",
    "@loomwork/plugin-sqlite": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
