{
  "name": "@loom/sdk",
  "version": "0.0.1",
  "description": "Public re-export surface for the Loom framework",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "require": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "require": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "require": "./dist/sandbox.js",
      "default": "./dist/sandbox.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/agent-surface": "workspace:*",
    "@loom/agent": "workspace:*",
    "@loom/blueprint-runtime": "workspace:*",
    "@loom/capability": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/intent": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/memory": "workspace:*",
    "@loom/orchestration": "workspace:*",
    "@loom/planner": "workspace:*",
    "@loom/plugin-a2a": "workspace:*",
    "@loom/plugin-mcp": "workspace:*",
    "@loom/plugin-postgres": "workspace:*",
    "@loom/plugin-renderer-terminal": "workspace:*",
    "@loom/plugin-sandbox": "workspace:*",
    "@loom/plugin-sqlite": "workspace:*",
    "@loom/projection-runtime": "workspace:*",
    "@loom/reasoning": "workspace:*",
    "@loom/registry": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
