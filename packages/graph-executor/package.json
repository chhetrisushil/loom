{
  "name": "@loom/graph-executor",
  "version": "0.0.1",
  "description": "Distributed execution graph for Loom — fans a set of nodes into per-node executions (one writer each), dispatches them concurrently via the ExecutionDispatcher, records lineage, and joins the results",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loom/dispatcher": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/scheduler": "workspace:*",
    "@loom/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/plugin-cloudrun": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/worker-runtime-local": "workspace:*",
    "@loom/plugin-worker-server": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8",
    "@loom/plugin-sqlite": "workspace:*"
  }
}
