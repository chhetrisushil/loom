{
  "name": "@loomwork/conformance",
  "version": "0.1.1",
  "description": "Portable SPI conformance kits for Loom — run run<Spi>Conformance(factory) in your vitest suite to prove a store/dispatcher/timer/projection backend conforms. Ships ESM so `import vitest` resolves natively; vitest is a peer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "dependencies": {
    "@loomwork/core": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "@loomwork/dispatcher": "workspace:^",
    "@loomwork/projection-runtime": "workspace:^",
    "@loomwork/worker-runtime": "workspace:^",
    "@loomwork/llm": "workspace:^",
    "@loomwork/effect-runtime": "workspace:^",
    "@loomwork/sandbox": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "packages/conformance"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
