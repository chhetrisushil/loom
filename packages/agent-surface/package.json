{
  "name": "@loom/agent-surface",
  "version": "0.0.1",
  "description": "Agent-surface — Loom's native, event-sourced patch protocol for driving durable, replayable UI surfaces",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loom/classify": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/projection-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/effect-runtime": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@loom/workflow-runtime": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@loom/workflow-runtime": {
      "optional": true
    }
  }
}
