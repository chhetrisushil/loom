{
  "name": "@loom/app",
  "version": "0.0.1",
  "description": "App composition for Loom \u2014 defineConfig assembles the durable runtime, effect middleware, projection, and A2A transport from a static config, so apps skip the copy-pasted composition root",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/agent": "workspace:*",
    "@loom/agent-surface": "workspace:*",
    "@loom/classify": "workspace:*",
    "@loom/compliance": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/dispatcher": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/knowledge": "workspace:*",
    "@loom/memory": "workspace:*",
    "@loom/middleware": "workspace:*",
    "@loom/plugin-a2a": "workspace:*",
    "@loom/projection-runtime": "workspace:*",
    "@loom/replay-vm": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/telemetry": "workspace:*",
    "@loom/verify": "workspace:*",
    "@loom/worker-runtime-local": "workspace:*",
    "@loom/workflow-runtime": "workspace:*"
  },
  "devDependencies": {
    "@loom/compiler": "workspace:*",
    "@loom/scaffold": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
