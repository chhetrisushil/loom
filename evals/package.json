{
  "name": "@loom/evals-internal",
  "version": "0.0.1",
  "private": true,
  "description": "Loom's own evals (ADR 0131): regression gates for the quality of the first-party agentic layer (tool search, memory and knowledge retrieval, skill discovery, agentLoop$ tasks, appgen and planner plans). Repo-internal and unpublished; imported by no runtime package.",
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist out tsconfig.tsbuildinfo",
    "eval": "tsc --build && node dist/run.js",
    "eval:update-baseline": "tsc --build && node dist/run.js --update-baseline",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "eval:author": "tsc --build && node dist/author.js",
    "eval:record": "tsc --build && node dist/record.js"
  },
  "dependencies": {
    "@loom/agent": "workspace:*",
    "@loom/agent-surface": "workspace:*",
    "@loom/appgen": "workspace:*",
    "@loom/appgen-model": "workspace:*",
    "@loom/capability": "workspace:*",
    "@loom/classify": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/eval": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/intent": "workspace:*",
    "@loom/knowledge": "workspace:*",
    "@loom/llm": "workspace:*",
    "@loom/memory": "workspace:*",
    "@loom/middleware": "workspace:*",
    "@loom/planner": "workspace:*",
    "@loom/plugin-postgres": "workspace:*",
    "@loom/plugin-sqlite": "workspace:*",
    "@loom/reasoning": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
