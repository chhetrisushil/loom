{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      // Part of the CACHE KEY, not just passed through. Without this, a cached
      // "passed" from a run with no database is replayed verbatim for a run that
      // has one — turbo reports FULL TURBO and the Postgres suites never execute.
      // Same for LOOM_TEST_SRC, where the cached run resolved the other tree.
      "env": ["LOOM_TEST_POSTGRES_URL", "LOOM_TEST_SRC"]
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
