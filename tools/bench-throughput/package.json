{
  "name": "@loomwork/bench-throughput",
  "version": "0.0.1",
  "private": true,
  "description": "Sustained-throughput harness for Loom's durable write path \u2014 measures events/sec and executions/sec against a real Postgres under concurrency, plus the appendBatch counterfactual and the pg_notify fan-out cost. Test/dev-only; imported by no runtime package.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsc --build && node dist/index.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "hardware": "tsc --build && node dist/hardware.js",
    "bench:fence": "tsc --build && node dist/fenceIf.js",
    "bench:inbox": "tsc --build && node dist/inbox.js",
    "bench:lease": "tsc --build && node dist/leaseOverhead.js",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/core": "workspace:*",
    "@loomwork/effect-runtime": "workspace:*",
    "@loomwork/event-runtime": "workspace:*",
    "@loomwork/plugin-postgres": "workspace:*",
    "@loomwork/plugin-sqlite": "workspace:*",
    "@loomwork/snapshot-runtime": "workspace:*",
    "@loomwork/workflow-runtime": "workspace:*",
    "pg": "^8.13.0",
    "zod": "^3.23.8",
    "@loomwork/middleware": "workspace:*",
    "@loomwork/replay-vm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
