{
  "name": "@loom/bench-throughput",
  "version": "0.0.1",
  "private": true,
  "description": "Sustained-throughput harness for Loom's durable write path — measures events/sec and executions/sec against a real Postgres under concurrency, plus the appendBatch counterfactual and the pg_notify fan-out cost. Test/dev-only; imported by no runtime package.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "bench": "tsc --build && node dist/index.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/effect-runtime": "workspace:*",
    "@loom/event-runtime": "workspace:*",
    "@loom/plugin-postgres": "workspace:*",
    "@loom/snapshot-runtime": "workspace:*",
    "@loom/workflow-runtime": "workspace:*",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.3"
  }
}
