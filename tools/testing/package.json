{
  "name": "@loomwork/testing",
  "version": "0.1.2",
  "description": "Testing kit for Loom apps — spin up an in-memory app, wait on surfaces, capture golden logs, and record/replay LLM calls, all over defineConfig",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/app": "workspace:^",
    "@loomwork/core": "workspace:^",
    "@loomwork/dispatcher": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/llm": "workspace:^",
    "@loomwork/projection-runtime": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "@loomwork/worker-runtime": "workspace:^",
    "@loomwork/workflow-runtime": "workspace:^",
    "vitest": "^2.1.8"
  },
  "devDependencies": {
    "@loomwork/conformance": "workspace:*",
    "@loomwork/effect-runtime": "workspace:*",
    "@loomwork/middleware": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "tools/testing"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
