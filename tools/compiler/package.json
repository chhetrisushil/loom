{
  "name": "@loomwork/compiler",
  "version": "0.1.0",
  "description": "Vite plugin and CLI compiler for the Loom framework — handler$ extraction, flow graph analysis, and resumability",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "loom-compile": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "magic-string": "^0.30.21",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "tools/compiler"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
