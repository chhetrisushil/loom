{
  "name": "@loomwork/cli",
  "version": "0.1.1",
  "description": "The loom CLI — project-local commands over the durable log: logs, debug (time-travel), eval",
  "bin": {
    "loom": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@loomwork/analytics": "workspace:^",
    "@loomwork/app": "workspace:^",
    "@loomwork/appgen": "workspace:^",
    "@loomwork/classify": "workspace:^",
    "@loomwork/compliance": "workspace:^",
    "@loomwork/core": "workspace:^",
    "@loomwork/deploy-sim": "workspace:^",
    "@loomwork/effect-runtime": "workspace:^",
    "@loomwork/eval": "workspace:^",
    "@loomwork/event-runtime": "workspace:^",
    "@loomwork/knowledge": "workspace:^",
    "@loomwork/learning": "workspace:^",
    "@loomwork/llm": "workspace:^",
    "@loomwork/orchestration": "workspace:^",
    "@loomwork/plugin-content": "workspace:^",
    "@loomwork/plugin-kit": "workspace:^",
    "@loomwork/plugin-sqlite": "workspace:^",
    "@loomwork/replay-vm": "workspace:^",
    "@loomwork/scaffold": "workspace:^",
    "@loomwork/snapshot-runtime": "workspace:^",
    "@loomwork/spec": "workspace:^",
    "@loomwork/verify": "workspace:^",
    "@loomwork/workflow-runtime": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loomwork/memory": "workspace:*",
    "@loomwork/plugin-crypto": "workspace:*",
    "@loomwork/workflow-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom.git",
    "directory": "tools/cli"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
